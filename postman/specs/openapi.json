          {
            "name": "instrument",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by instrument ('piano' or 'guitar')",
              "title": "Instrument"
            },
            "description": "Filter by instrument ('piano' or 'guitar')"
          },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by difficulty level (1-5, or 'beginner', 'intermediate', 'advanced')",
              "title": "Difficulty"
            },
            "description": "Filter by difficulty level (1-5, or 'beginner', 'intermediate', 'advanced')"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
