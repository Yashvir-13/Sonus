  "components": {
    "schemas": {
      "AdaptiveInterventionRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "pattern_id": {
            "type": "string",
            "title": "Pattern Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "drill_type": {
            "type": "string",
            "title": "Drill Type"
          },
          "target_tempo": {
            "type": "integer",
            "title": "Target Tempo"
          },
          "target_repetitions": {
            "type": "integer",
            "title": "Target Repetitions"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "measured_improvement": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured Improvement"
          }
        },
        "type": "object",
        "required": [
          "id",
          "pattern_id",
          "user_id",
          "drill_type",
          "target_tempo",
          "target_repetitions",
          "completed"
        ],
        "title": "AdaptiveInterventionRead",
        "description": "Schema for reading adaptive interventions."
      },
      "ChordDefinition": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "beat": {
            "type": "number",
            "minimum": 0.0,
            "title": "Beat",
            "default": 1.0
          },
          "duration_beats": {
            "type": "number",
            "minimum": 0.5,
            "title": "Duration Beats",
            "default": 4.0
          },
          "expected_pitches": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Expected Pitches"
          },
          "guitar_tabs": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GuitarTabs"
              },
              {
                "type": "null"
              }
            ]
          },
          "piano_voicings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PianoVoicings"
              },
              {
                "type": "null"
              }
            ]
          },
          "common_mistakes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Common Mistakes"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ChordDefinition",
        "description": "Discrete reference chord event in an exercise."
      },
      "CustomExerciseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "instrument": {
            "type": "string",
            "pattern": "^(piano|guitar)$",
            "title": "Instrument"
          },
          "tempo_bpm": {
            "type": "integer",
            "maximum": 220.0,
            "minimum": 40.0,
            "title": "Tempo Bpm",
            "default": 80
          },
          "difficulty": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Difficulty",
            "default": 1
          },
          "progression": {
            "$ref": "#/components/schemas/ProgressionData"
          }
        },
        "type": "object",
        "required": [
          "title",
          "instrument",
          "progression"
        ],
        "title": "CustomExerciseCreate",
        "description": "Payload for creating a custom practice exercise."
      },
      "ExerciseDetailRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "instrument": {
            "type": "string",
            "title": "Instrument"
          },
          "tempo_bpm": {
            "type": "integer",
            "title": "Tempo Bpm"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "progression": {
            "$ref": "#/components/schemas/ProgressionData"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "instrument",
          "tempo_bpm",
          "difficulty",
          "progression"
        ],
        "title": "ExerciseDetailRead",
        "description": "Detailed exercise view with parsed progression schema."
      },
      "ExerciseRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "instrument": {
            "type": "string",
            "title": "Instrument"
          },
          "tempo_bpm": {
            "type": "integer",
            "title": "Tempo Bpm"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "progression_json": {
            "type": "string",
            "title": "Progression Json"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "instrument",
          "tempo_bpm",
          "difficulty",
          "progression_json"
        ],
        "title": "ExerciseRead",
        "description": "Schema for reading an exercise."
      },
      "GuitarTabs": {
        "properties": {
          "frets": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Frets",
            "description": "Fret numbers per string (None for muted)"
          },
          "strings": {
            "type": "string",
            "title": "Strings",
            "default": "E-A-D-G-B-e"
          },
          "fingering": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fingering"
          }
        },
        "type": "object",
        "title": "GuitarTabs",
        "description": "Fretboard fingering and string positions for guitar."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
