{
  "name": "adaptive-music-practice",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Musical Practice System (Sonus) monorepo (Vite web + FastAPI backend)",
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"python scripts/run.py service:api\" \"npm run --prefix apps/web dev\"",
    "dev:web": "npm run --prefix apps/web dev",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"python scripts/run.py service:api\" \"npm run --prefix apps/web dev\"",
    "build": "npm run --prefix apps/web build",
    "lint": "npm run --prefix apps/web lint",
    "preview": "npm run --prefix apps/web preview",
    "test": "npm run --prefix apps/web test",
    "test:e2e": "playwright test",
    "db:create": "python scripts/run.py db:create",
    "db:clean": "python scripts/run.py db:clean",
    "db:make": "python scripts/run.py db:make",
    "db:upgrade": "python scripts/run.py db:upgrade",
    "app:web": "python scripts/run.py app:web",
    "service:api": "python scripts/run.py service:api",
    "auth:token": "python scripts/get_token.py",
    "app:clean:all": "npx rimraf node_modules apps/web/node_modules apps/web/dist",
    "app:clean:install": "npm run app:clean:all && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@playwright/test": "^1.65.1",
    "gsap": "^3.15.1"
  }
}
